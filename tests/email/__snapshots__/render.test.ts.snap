// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderHtml > matches a stable snapshot grouped by severity 1`] = `"<!doctype html><html><body style="margin:0;padding:0;background:#eef2f7;"><div style="max-width:640px;margin:0 auto;padding:24px;background:#ffffff;font-family:-apple-system,Segoe UI,sans-serif;color:#0f172a;"><div style="border-bottom:2px solid #0f172a;padding-bottom:12px;margin-bottom:16px;"><div style="font:700 20px/1.2 -apple-system,Segoe UI,sans-serif;color:#0f172a;">cryptosweep PQ readiness report</div><div style="font:13px/1.5 -apple-system,Segoe UI,sans-serif;color:#475569;margin-top:4px;">Target: example.com &middot; Scanned: 2026-05-30T12:00:00.000Z</div></div><p style="font:14px/1.5 -apple-system,Segoe UI,sans-serif;color:#0f172a;margin:0 0 12px;">Total findings: 4 (critical 1, high 1, medium 1, low 1).</p><h2 style="font:600 16px/1.3 -apple-system,Segoe UI,sans-serif;color:#b91c1c;margin:20px 0 8px;">Critical (1)</h2><div style="margin:0 0 16px 0;padding:12px 14px;border-left:4px solid #b91c1c;background:#f8fafc;"><div style="font:600 14px/1.4 -apple-system,Segoe UI,sans-serif;color:#0f172a;">CSW-TLS-001, Leaf public key: RSA-2048</div><div style="font:13px/1.5 -apple-system,Segoe UI,sans-serif;color:#334155;margin-top:4px;"><strong>Evidence:</strong> vuln.example.com:443<br/><strong>PQ status:</strong> vulnerable<br/><strong>NIST-aligned remediation:</strong> Plan migration to hybrid ML-KEM / ML-DSA certificates per NIST SP 800-208.</div></div><h2 style="font:600 16px/1.3 -apple-system,Segoe UI,sans-serif;color:#c2410c;margin:20px 0 8px;">High (1)</h2><div style="margin:0 0 16px 0;padding:12px 14px;border-left:4px solid #c2410c;background:#f8fafc;"><div style="font:600 14px/1.4 -apple-system,Segoe UI,sans-serif;color:#0f172a;">CSW-SRC-002, MD5 in node:crypto</div><div style="font:13px/1.5 -apple-system,Segoe UI,sans-serif;color:#334155;margin-top:4px;"><strong>Evidence:</strong> src/legacy/hash.ts:42<br/><strong>PQ status:</strong> vulnerable<br/><strong>NIST-aligned remediation:</strong> Replace MD5 with SHA-256 (FIPS 180-4) and consider SHA3 for new code.</div></div><h2 style="font:600 16px/1.3 -apple-system,Segoe UI,sans-serif;color:#a16207;margin:20px 0 8px;">Medium (1)</h2><div style="margin:0 0 16px 0;padding:12px 14px;border-left:4px solid #a16207;background:#f8fafc;"><div style="font:600 14px/1.4 -apple-system,Segoe UI,sans-serif;color:#0f172a;">CSW-DEP-003, Dependency: jsonwebtoken</div><div style="font:13px/1.5 -apple-system,Segoe UI,sans-serif;color:#334155;margin-top:4px;"><strong>Evidence:</strong> package.json:jsonwebtoken@9.0.2<br/><strong>PQ status:</strong> transitional<br/><strong>NIST-aligned remediation:</strong> Migrate signing to ML-DSA (FIPS 204) once an ecosystem-supported library lands.</div></div><h2 style="font:600 16px/1.3 -apple-system,Segoe UI,sans-serif;color:#1d4ed8;margin:20px 0 8px;">Low (1)</h2><div style="margin:0 0 16px 0;padding:12px 14px;border-left:4px solid #1d4ed8;background:#f8fafc;"><div style="font:600 14px/1.4 -apple-system,Segoe UI,sans-serif;color:#0f172a;">CSW-DEP-004, Dependency: rsa (python)</div><div style="font:13px/1.5 -apple-system,Segoe UI,sans-serif;color:#334155;margin-top:4px;"><strong>Evidence:</strong> requirements.txt:rsa@4.9<br/><strong>PQ status:</strong> vulnerable<br/><strong>NIST-aligned remediation:</strong> Track migration to hybrid / ML-KEM for any key exchange touched by this dep.</div></div><p style="font:12px/1.5 -apple-system,Segoe UI,sans-serif;color:#64748b;margin-top:24px;border-top:1px solid #e2e8f0;padding-top:12px;">Generated by cryptosweep. Remediation guidance aligned with NIST SP 800-208 / FIPS 203 / FIPS 204.</p></div></body></html>"`;

exports[`renderText > matches a stable snapshot grouped by severity 1`] = `
"cryptosweep PQ readiness report
Target: example.com
Scanned: 2026-05-30T12:00:00.000Z

Total findings: 4 (critical 1, high 1, medium 1, low 1).

Critical (1)
------------
  [CSW-TLS-001] Leaf public key: RSA-2048
    Evidence: vuln.example.com:443
    PQ status: vulnerable
    NIST-aligned remediation: Plan migration to hybrid ML-KEM / ML-DSA certificates per NIST SP 800-208.

High (1)
--------
  [CSW-SRC-002] MD5 in node:crypto
    Evidence: src/legacy/hash.ts:42
    PQ status: vulnerable
    NIST-aligned remediation: Replace MD5 with SHA-256 (FIPS 180-4) and consider SHA3 for new code.

Medium (1)
----------
  [CSW-DEP-003] Dependency: jsonwebtoken
    Evidence: package.json:jsonwebtoken@9.0.2
    PQ status: transitional
    NIST-aligned remediation: Migrate signing to ML-DSA (FIPS 204) once an ecosystem-supported library lands.

Low (1)
-------
  [CSW-DEP-004] Dependency: rsa (python)
    Evidence: requirements.txt:rsa@4.9
    PQ status: vulnerable
    NIST-aligned remediation: Track migration to hybrid / ML-KEM for any key exchange touched by this dep.

-- Generated by cryptosweep. Remediation guidance aligned with NIST SP 800-208 / FIPS 203 / FIPS 204."
`;
