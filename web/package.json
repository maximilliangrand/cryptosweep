{
  "name": "@cryptosweep/web",
  "version": "0.1.0",
  "private": true,
  "description": "Cryptosweep landing page + scan-request capture (Cloudflare Worker).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "wrangler d1 execute cryptosweep_web_dev --local --file=src/storage/d1-schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.10",
    "@cloudflare/workers-types": "4.20260529.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vitest": "4.1.7",
    "wrangler": "4.95.0"
  }
}
