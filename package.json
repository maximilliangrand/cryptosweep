{
  "name": "cryptosweep",
  "version": "0.2.0",
  "description": "Inventory the cryptography in TLS endpoints, source code and dependency manifests, and plan a post-quantum migration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilliangrand/cryptosweep.git"
  },
  "homepage": "https://github.com/maximilliangrand/cryptosweep#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cryptosweep": "./dist/cli.js",
    "cryptosweep-mcp": "./dist/mcp.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build:viewer": "node scripts/build-viewer.mjs",
    "prebuild": "node scripts/build-viewer.mjs",
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cac": "7.0.0"
  },
  "devDependencies": {
    "@babel/parser": "7.28.4",
    "@babel/types": "7.28.4",
    "@blueprintjs/core": "5",
    "@blueprintjs/icons": "5",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "@types/react": "18",
    "@types/react-dom": "18",
    "esbuild": "0.28.1",
    "eslint": "10.4.0",
    "prettier": "3.8.3",
    "react": "18",
    "react-dom": "18",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vitest": "4.1.7"
  }
}
